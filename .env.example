# ---------------------------------------------------------------------------
# drf2go environment template.
#
#   make env      # copies this file to .env
#
# Values here are development-safe defaults. Everything marked REQUIRED IN
# PRODUCTION is validated at startup when DEBUG is off - the process refuses to
# boot rather than running with a known-insecure default.
#
# The compose files own the container topology (DEBUG, service hostnames and
# ports), so the *_HOST/*_PORT entries below only apply when Django runs
# directly on the host. Credentials and application settings always come from
# this file. Point the stacks at a different file with:
#
#   make up ENV_FILE=.env.staging
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-secure-key
DEBUG=True
# Comma-separated hostnames Django will answer for.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated https:// origins allowed to POST (admin, session auth).
CSRF_TRUSTED_ORIGINS=
# Path to the real Django admin; /admin/ is the honeypot.
ADMIN_URL=secret-admin/

LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# --- Database --------------------------------------------------------------
POSTGRES_DB=drf2go
POSTGRES_USER=db_user
POSTGRES_PASSWORD=replace-me-with-secure-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional full connection URL. Leave unset to use the POSTGRES_* parts above
# (which is what the compose stacks do); set it to point at a managed database.
# DATABASE_URL=postgresql://db_user:secret@localhost:5432/drf2go
# Seconds to keep a database connection open for reuse (0 disables pooling).
DB_CONN_MAX_AGE=60

# --- HTTPS / security (only applied when DEBUG=False) -----------------------
# Enable once TLS terminates in front of nginx, otherwise you get a redirect loop.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- CORS ------------------------------------------------------------------
CORS_ORIGIN_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
CORS_ALLOW_CREDENTIALS=False
CORS_ALLOW_METHODS=DELETE,GET,OPTIONS,PATCH,POST,PUT

# --- REST framework --------------------------------------------------------
DRF_PAGE_SIZE=50
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=1000/min
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=90
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# --- API documentation (drf-spectacular) -----------------------------------
SPECTACULAR_TITLE=DRF2GO Backend API
SPECTACULAR_DESCRIPTION=DRF2GO Backend API
SPECTACULAR_VERSION=1.0.0
SPECTACULAR_SERVE_INCLUDE_SCHEMA=False

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Force DEBUG everywhere, overriding LOG_LEVEL.
LOG_ALL_LEVELS=False
LOG_TO_CONSOLE=True
LOG_TO_FILE=False
# verbose | json
LOG_FORMAT=verbose
LOG_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
LOG_DB_QUERIES=False

# --- RabbitMQ (Celery broker) ----------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
# REQUIRED IN PRODUCTION - "guest" is rejected when DEBUG is off.
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# Overridden by the compose files. Set this when running outside Docker.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# --- Celery ----------------------------------------------------------------
# Leave unset to store results in Redis (database CELERY_RESULT_BACKEND_DB).
# CELERY_RESULT_BACKEND=
CELERY_RESULT_BACKEND_DB=1
CELERY_RESULT_EXPIRES=86400
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=60

# --- Redis (Channels layer) ------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# REQUIRED IN PRODUCTION - an empty password is rejected when DEBUG is off.
REDIS_PASSWORD=dev-redis-password
REDIS_DB=0
# Overridden by the compose files. Set this when running outside Docker.
# REDIS_URL=redis://:dev-redis-password@localhost:6379/0
# Use the in-memory channel layer instead of Redis (single process only).
CHANNEL_LAYER_IN_MEMORY=False

# --- Docker / nginx --------------------------------------------------------
# Host ports published by the stacks.
WEB_PORT=8000
HTTP_PORT=80
# nginx server_name and upload limit (production stack).
SERVER_NAME=_
CLIENT_MAX_BODY_SIZE=100M
