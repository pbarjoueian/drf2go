[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
# --- Core framework ---------------------------------------------------------
# Pinned to the 6.0 series: django-celery-beat 2.9.0 requires Django<6.1.
django = "==6.0.8"
djangorestframework = "==3.18.0"
django-filter = "==26.1"
django-cors-headers = "==4.9.0"
djangorestframework-simplejwt = "==5.5.1"
django-environ = "==0.14.0"
markdown = "==3.10.3"

# --- Database ---------------------------------------------------------------
psycopg = {extras = ["binary", "pool"], version = "==3.3.4"}

# --- API schema / docs ------------------------------------------------------
drf-spectacular = "==0.30.0"

# --- Security ---------------------------------------------------------------
django-admin-honeypot1 = "==1.2.0"

# --- Async tasks ------------------------------------------------------------
celery = "==5.6.3"
django-celery-beat = "==2.9.0"

# --- WebSockets / ASGI ------------------------------------------------------
channels = "==4.3.2"
channels-redis = "==4.3.0"
daphne = "==4.2.3"

# --- Observability ----------------------------------------------------------
python-json-logger = "==4.1.0"

[dev-packages]
ruff = "==0.16.2"
pre-commit = "==4.6.1"
pytest = "==9.1.1"
pytest-django = "==4.13.0"
pytest-cov = "==7.1.0"
pytest-mock = "==3.15.1"
websockets = "==17.0.1"

[requires]
python_version = "3.13"

[scripts]
lint = "ruff check ."
format = "ruff format ."
test = "pytest"
manage = "python manage.py"
