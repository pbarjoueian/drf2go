# Example environment variables for the project.
# Copy this file to `.env` and fill in real secrets/values as appropriate.

# Django secret key (keep this secret in production)
SECRET_KEY=replace-me-with-a-secure-key

# Enable/disable debug mode
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Database configuration
# PostgreSQL connection parameters (alternative to DATABASE_URL)
# PostgreSQL database name
POSTGRES_DB=db
# PostgreSQL database user
POSTGRES_USER=db_user
# PostgreSQL database password
POSTGRES_PASSWORD=replace-me-with-secure-password
# PostgreSQL database host (default: db for Docker, localhost for local)
POSTGRES_HOST=db
# PostgreSQL database port (default: 5432)
POSTGRES_PORT=5432

# Optional
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# CORS (Cross-Origin Resource Sharing) configuration
# Allow all origins (use False in production and specify allowed origins)
CORS_ORIGIN_ALLOW_ALL=True
# Comma-separated list of allowed HTTP methods
CORS_ALLOW_METHODS=DELETE,GET,OPTIONS,PATCH,POST,PUT
# Comma-separated list of allowed origins (e.g., frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
# Comma-separated list of allowed origin patterns (wildcards supported)
CORS_ORIGIN_WHITELIST=*

# API Documentation (drf-spectacular/Swagger)
# API documentation title
SPECTACULAR_TITLE=Backend API
# API documentation description
SPECTACULAR_DESCRIPTION=Backend API
# API documentation version
SPECTACULAR_VERSION=1.0.0
# Include schema in OpenAPI schema response
SPECTACULAR_SERVE_INCLUDE_SCHEMA=False

# Nginx configuration
# Server name for nginx (default: _)
SERVER_NAME=_

# Logging configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
# Capture and store ALL log levels (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# When True, overrides LOG_LEVEL and sets all handlers/loggers to DEBUG
# (default: False)
LOG_ALL_LEVELS=False
# Enable console logging (default: True)
LOG_TO_CONSOLE=True
# Enable file logging (default: False, recommended True for production)
LOG_TO_FILE=False
# Log format: 'verbose' for human-readable, 'json' for structured JSON (default: verbose)
LOG_FORMAT=verbose
# Directory for log files (default: logs/ in project root)
LOG_DIR=logs
# Maximum size of log file before rotation in bytes (default: 10MB)
LOG_FILE_MAX_BYTES=10485760
# Number of backup log files to keep (default: 5)
LOG_FILE_BACKUP_COUNT=5
# Enable database query logging (default: False, set True for debugging)
LOG_DB_QUERIES=False

# Celery Configuration
# Celery broker URL (RabbitMQ connection string)
# Format: amqp://username:password@host:port/vhost
# If not set, will be built from RABBITMQ_* parameters below
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
# Celery result backend (use 'rpc://' for RPC backend or Redis URL)
CELERY_RESULT_BACKEND=rpc://

# RabbitMQ Configuration
# RabbitMQ connection URL (format: amqp://user:pass@host:port/vhost)
# If not set, individual parameters below will be used
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
# RabbitMQ host (default: rabbitmq)
RABBITMQ_HOST=rabbitmq
# RabbitMQ port (default: 5672)
RABBITMQ_PORT=5672
# RabbitMQ username (default: guest)
RABBITMQ_USER=guest
# RabbitMQ password (default: guest)
# WARNING: Must be changed from 'guest' in production!
RABBITMQ_PASSWORD=guest
# RabbitMQ virtual host (default: /)
RABBITMQ_VHOST=/

# Redis Configuration (for Channels WebSocket support)
# Redis connection URL (format: redis://host:port or redis://password@host:port)
# If not set, individual parameters below will be used
REDIS_URL=redis://replace-me-with-secure-password@redis:6379/0
# Redis host (default: redis for Docker, localhost for local)
REDIS_HOST=redis
# Redis port (default: 6379)
REDIS_PORT=6379
# Redis password (REQUIRED in production - keep this secret!)
REDIS_PASSWORD=replace-me-with-secure-password
# Redis database number (default: 0)
REDIS_DB=0
